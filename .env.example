# Paste only keys. The rest has working defaults for local and Railway.

# ── KEYS (paste these in Railway Variables) ──────────────────────────
GROQ_API_KEY=
OPENROUTER_API_KEY=
OPENROUTER_BACKUP_API_KEY=
GOOGLE_API_KEY=
DEEPGRAM_API_KEY=
TELEGRAM_BOT_TOKEN=
OPENCODE_ZEN_API_KEY=
OPENCODE_ZEN_BASE_URL=
OPENCODE_ZEN_MODEL=

# ── AUTO ON RAILWAY (do not need to set if plugins are linked) ───────
# DATABASE_URL comes from the PostgreSQL plugin
# REDIS_URL comes from the Redis plugin
# PORT comes from Railway
# API_BASE_URL comes from RAILWAY_PUBLIC_DOMAIN
# JWT_ACCESS_SECRET is generated from the Railway service id if missing

NODE_ENV=development
DATABASE_URL=postgresql://talqyla:talqyla@localhost:5432/talqyla?schema=public
REDIS_URL=redis://localhost:6379
JWT_ACCESS_SECRET=change-me-access-secret-min-16-chars
API_PORT=4000
API_BASE_URL=http://localhost:4000
CORS_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

STT_PROVIDER=stub
GROQ_STT_MODEL=whisper-large-v3-turbo
GROQ_MODEL=llama-3.1-8b-instant
OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct:free
OPENROUTER_BACKUP_MODEL=google/gemma-2-9b-it:free
GOOGLE_MODEL=gemini-3.8-flash
GOOGLE_STT_MODEL=gemini-3.5-transcribe
DEEPGRAM_MODEL=nova-3
LLM_MODEL_JUDGE=anthropic/claude-haiku-4.5
LLM_MODEL_CASE=anthropic/claude-haiku-4.5
LLM_MODEL_DEBATER=anthropic/claude-haiku-4.5
TTS_PROVIDER=stub
