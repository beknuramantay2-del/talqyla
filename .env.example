# ─────────────────────────────────────────────────────────────────────────────
# Talqyla — переменные окружения (v2).
# Скопируй в `.env` и заполни. Все AI-сервисы поддерживают `stub`
# для разработки UI без ключей.
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=development

# ─── База данных ─────────────────────────────────────────────────────────────
POSTGRES_USER=talqyla
POSTGRES_PASSWORD=talqyla
POSTGRES_DB=talqyla
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql://talqyla:talqyla@localhost:5432/talqyla?schema=public

# ─── Redis (rate-limit, локаут аккаунта) ─────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── Аутентификация ──────────────────────────────────────────────────────────
# В проде приложение НЕ ЗАПУСТИТСЯ с дефолтом: openssl rand -hex 32
JWT_ACCESS_SECRET=change-me-access-secret-min-16-chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# ─── API ─────────────────────────────────────────────────────────────────────
API_PORT=4000
# В production обязан быть https:// — refresh-cookie ставится с secure: true.
API_BASE_URL=http://localhost:4000
# Origin фронтенда. Попадает и в CORS, и в CSP connect-src.
CORS_ORIGIN=http://localhost:3000
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000

# ─── Веб ─────────────────────────────────────────────────────────────────────
WEB_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# ─── Сессия (v2) ─────────────────────────────────────────────────────────────
# Единица тренировки — одна речь, а не раунд из трёх обменов.
SPEECH_PREP_SECONDS=180
SPEECH_MAX_SECONDS=240
SPEECH_MAX_CHARS=4000
BLITZ_MAX_CHARS=700
# POI — единственный остаток AI-оппонента. false = ноль вызовов кроме судьи.
POI_ENABLED=true

# ─── Кэпы расходов (на пользователя, за UTC-сутки) ───────────────────────────
# Проверяются ДО вызова по проектной стоимости. Срабатывает то, что упрётся первым.
DAILY_SESSION_LIMIT=20
DAILY_COST_LIMIT_USD=0.25
DAILY_STT_SECONDS_LIMIT=900
DAILY_TTS_CHARS_LIMIT=4000
# Legacy: раунды v1.
DAILY_ROUND_LIMIT=10
MAX_ROUND_EXCHANGES=3

# ─── LLM (OpenRouter: один ключ на все модели) ───────────────────────────────
# openrouter.ai, положи $20, ключ вида sk-or-v1-...
OPENROUTER_API_KEY=
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_REFERER=http://localhost:3000
LLM_APP_TITLE=Talqyla
# Судья — единственный обязательный платный вызов в сессии.
LLM_MODEL_JUDGE=anthropic/claude-haiku-4.5
# Кейс-карта кешируется на тему, поэтому модель можно взять поумнее.
LLM_MODEL_CASE=anthropic/claude-haiku-4.5
# POI — одна короткая реплика.
LLM_MODEL_DEBATER=anthropic/claude-haiku-4.5

# ─── Prompt injection ────────────────────────────────────────────────────────
# log — записать сигнал и продолжить (по умолчанию).
# block — отбить 400. Regex ложно срабатывает на нормальных фразах дебатов.
INJECTION_ACTION=log

# ─── STT: голос → текст ──────────────────────────────────────────────────────
# stub | groq | openai. Groq turbo дешевле large-v3 в 2.8 раза при том же WER.
STT_PROVIDER=stub
GROQ_STT_MODEL=whisper-large-v3-turbo
GROQ_API_KEY=
OPENAI_API_KEY=

# ─── TTS: озвучка ────────────────────────────────────────────────────────────
# По опросу озвучка не нужна, а стоит дороже всего остального. Держим stub.
TTS_PROVIDER=stub
TTS_VOICE=onyx
ELEVENLABS_API_KEY=
TTS_MAX_CHARS=420

# ─── Защита данных (пользователи несовершеннолетние) ─────────────────────────
PARENTAL_CONSENT_REQUIRED=true
CONSENT_VERSION=2026-07-01
TRANSCRIPT_RETENTION_DAYS=180
RETENTION_JOB_ENABLED=false

# ─── Мониторинг ──────────────────────────────────────────────────────────────
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1

# ─── Хранилище аудио ─────────────────────────────────────────────────────────
STORAGE_DIR=storage
