# ─────────────────────────────────────────────────────────────────────────────
# ДебатоТренер — переменные окружения
# Скопируй в `.env` и заполни. Все AI-сервисы поддерживают значение `stub`
# для разработки UI без ключей.
# ─────────────────────────────────────────────────────────────────────────────

# Режим
NODE_ENV=development

# ─── База данных (Postgres) ──────────────────────────────────────────────────
POSTGRES_USER=debato
POSTGRES_PASSWORD=debato
POSTGRES_DB=talqyla
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# Каноническая строка подключения, которую читает Prisma
DATABASE_URL=postgresql://debato:debato@localhost:5432/talqyla?schema=public

# ─── Redis (rate-limit, локаут аккаунта) ─────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# ─── Аутентификация (JWT) ────────────────────────────────────────────────────
# Access-токен — HS256 JWT, подписывается этим секретом. Минимум 16 символов.
# В dev можно оставить change-me..., в проде приложение НЕ ЗАПУСТИТСЯ с дефолтом:
# сгенерируй свой через `openssl rand -hex 32`.
# Refresh-токены — opaque (не JWT), хранятся в БД как sha256-хэш.
JWT_ACCESS_SECRET=change-me-access-secret-min-16-chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# ─── API-сервер (Fastify) ────────────────────────────────────────────────────
API_PORT=4000
# В production обязан быть https:// — refresh-cookie ставится с secure: true.
API_BASE_URL=http://localhost:4000
# Origin фронтенда для CORS (через запятую, если несколько). "*" запрещён в проде.
CORS_ORIGIN=http://localhost:3000
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000

# ─── Веб (Next.js) ───────────────────────────────────────────────────────────
WEB_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# ─── Раунд ───────────────────────────────────────────────────────────────────
# Сколько обменов «оппонент ↔ ученик» в спарринг-цикле. 3 = ~15 мин.
MAX_ROUND_EXCHANGES=3

# ─── Кэпы расходов (на пользователя, за UTC-сутки) ───────────────────────────
# Жёсткий потолок, чтобы один аккаунт не выжег весь баланс.
# Проверяются перед созданием раунда; срабатывает то, что упрётся первым.
DAILY_ROUND_LIMIT=10
DAILY_COST_LIMIT_USD=1.0

# ─── LLM (OpenRouter: один ключ на все модели) ───────────────────────────────
# Зарегистрируйся на openrouter.ai, положи $20, скопируй ключ (вид: sk-or-v1-...).
OPENROUTER_API_KEY=
LLM_BASE_URL=https://openrouter.ai/api/v1
# Приложение шлёт эти заголовки для статистики OpenRouter.
LLM_REFERER=http://localhost:3000
LLM_APP_TITLE=ДебатоТренер
# Haiku 4.5 ($1/$5 за MTok) держит уровень Sonnet-4 и заменяет обе старые модели.
LLM_MODEL_DEBATER=anthropic/claude-haiku-4.5
LLM_MODEL_JUDGE=anthropic/claude-haiku-4.5
LLM_MODEL_SUMMARIZER=anthropic/claude-haiku-4.5

# Суммаризатор — ЛИШНИЙ вызов LLM ради сжатия ~600 токенов истории.
# При MAX_ROUND_EXCHANGES <= 4 это чистый убыток. Включай только для длинных раундов.
SUMMARIZER_ENABLED=false

# ─── Prompt injection ────────────────────────────────────────────────────────
# log   — записать сигнал и продолжить раунд (по умолчанию). Изоляция держится
#         на делимитерах <STUDENT_SPEECH> и правилах в системном промпте.
# block — отбить ввод 400-й. Regex-блэклист ложно срабатывает на нормальных
#         фразах дебатов, поэтому блокировка бьёт по ученикам сильнее, чем по атакующим.
INJECTION_ACTION=log

# ─── STT: голос → текст (Whisper-совместимый) ────────────────────────────────
# stub — заглушка для разработки UI без ключа
# groq  — Whisper-large-v3 через Groq (дёшево/быстро, рекомендуется для MVP)
# openai — Whisper-1 через OpenAI
STT_PROVIDER=stub
GROQ_API_KEY=
OPENAI_API_KEY=

# ─── TTS: текст → голос оппонента ────────────────────────────────────────────
# stub     — тихий mp3-маркер для разработки UI
# openai   — tts-1 (6 голосов, alloy/echo/fable/onyx/nova/shimmer)
# elevenlabs — реалистичные голоса ($22/мес, hook уже заложен)
TTS_PROVIDER=stub
TTS_VOICE=onyx
ELEVENLABS_API_KEY=
# TTS тарифицируется посимвольно и это ~50% себестоимости раунда.
# Без потолка /voice/tts превращается в бесплатный TTS-API за наш счёт.
TTS_MAX_CHARS=800

# ─── Защита данных (пользователи — несовершеннолетние, 7–11 класс) ───────────
PARENTAL_CONSENT_REQUIRED=true
CONSENT_VERSION=2026-07-01
# Через сколько дней обезличивать транскрипты. Числовые оценки сохраняются.
TRANSCRIPT_RETENTION_DAYS=180
# Гонять очистку встроенным суточным таймером (для деплоя в одном инстансе).
# Если инстансов несколько — оставь false и запускай `pnpm retention:purge` по крону.
RETENTION_JOB_ENABLED=false

# ─── Мониторинг ошибок (Sentry) ─────────────────────────────────────────────
# DSN проекта в Sentry. Оставь пустым, чтобы отключить Sentry.
SENTRY_DSN=
# Доля запросов для трассировки (0.0–1.0). 0.1 = 10% в проде.
SENTRY_TRACES_SAMPLE_RATE=0.1

# ─── Хранилище аудио (dev = локальная папка) ─────────────────────────────────
STORAGE_DIR=storage

# ─── Eval судьи (только для `pnpm eval:judge:live`) ──────────────────────────
# Порог средней абсолютной ошибки против golden set и разброса между прогонами.
EVAL_MAE_THRESHOLD=1.5
EVAL_SPREAD_THRESHOLD=2.0
