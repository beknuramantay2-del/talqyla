# ─────────────────────────────────────────────────────────────────────────────
# ДебатоТренер — переменные окружения
# Скопируй в `.env` и заполни. Все AI-сервисы поддерживают значение `stub`
# для разработки UI без ключей.
# ─────────────────────────────────────────────────────────────────────────────

# Режим
NODE_ENV=development

# ─── База данных (Postgres) ──────────────────────────────────────────────────
POSTGRES_USER=debato
POSTGRES_PASSWORD=debato
POSTGRES_DB=talqyla
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# Каноническая строка подключения, которую читает Prisma
DATABASE_URL=postgresql://debato:debato@localhost:5432/talqyla?schema=public

# ─── Redis (rate-limit) ──────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# ─── Аутентификация (JWT) ────────────────────────────────────────────────────
# Access-токен — HS256 JWT, подписывается этим секретом. Минимум 16 символов.
# В dev можно оставить change-me..., в проде — сгенерировать (`openssl rand -hex 32`).
# Refresh-токены — opaque (не JWT), хранятся в БД как sha256-хэш, секрета не требуют.
JWT_ACCESS_SECRET=change-me-access-secret-min-16-chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# ─── API-сервер (Fastify) ────────────────────────────────────────────────────
API_PORT=4000
API_BASE_URL=http://localhost:4000
# Origin фронтенда для CORS (через запятую, если несколько)
CORS_ORIGIN=http://localhost:3000
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000

# ─── Веб (Next.js) ───────────────────────────────────────────────────────────
WEB_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# ─── Раунд ───────────────────────────────────────────────────────────────────
# Сколько обменов «оппонент ↔ ученик» в спарринг-цикле. 3 = ~15 мин, ~$0.08/раунд.
MAX_ROUND_EXCHANGES=3

# ─── LLM (OpenRouter: один ключ на все модели) ───────────────────────────────
# Зарегистрируйся на openrouter.ai, положи $20, скопируй ключ (вид: sk-or-v1-...).
OPENROUTER_API_KEY=
LLM_BASE_URL=https://openrouter.ai/api/v1
# Приложение шлёт эти заголовки для статистики OpenRouter (обязательно).
LLM_REFERER=http://localhost:3000
LLM_APP_TITLE=ДебатоТренер
# Дешёвая модель для оппонента и суммаризатора
LLM_MODEL_DEBATER=anthropic/claude-3.5-haiku
# Дорогая модель для агента-судьи (1 вызов за раунд)
LLM_MODEL_JUDGE=anthropic/claude-3.5-sonnet

# ─── STT: голос → текст (Whisper-совместимый) ────────────────────────────────
# stub — заглушка для разработки UI без ключа
# groq  — Whisper-large-v3 через Groq (дёшево/быстро, рекомендуется для MVP)
# openai — Whisper-1 через OpenAI
STT_PROVIDER=stub
GROQ_API_KEY=
OPENAI_API_KEY=

# ─── TTS: текст → голос оппонента ────────────────────────────────────────────
# stub     — тихий mp3-маркер для разработки UI
# openai   — tts-1 (6 голосов, alloy/echo/fable/onyx/nova/shimmer)
# elevenlabs — реалистичные голоса ($22/мес, hook уже заложен)
TTS_PROVIDER=stub
TTS_VOICE=onyx
ELEVENLABS_API_KEY=

# ─── Мониторинг ошибок (Sentry) ─────────────────────────────────────────────
# DSN проекта в Sentry. Оставь пустым, чтобы отключить Sentry.
SENTRY_DSN=
# Доля запросов для трассировки (0.0–1.0). 0.1 = 10% в проде.
SENTRY_TRACES_SAMPLE_RATE=0.1

# ─── Хранилище аудио (dev = локальная папка) ─────────────────────────────────
STORAGE_DIR=storage
