# Add secret values only in Railway Variables. Never commit real keys.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_WEBAPP_URL=

# LLM routing. Two dedicated OpenAI keys use gpt-4o-mini for reasoning and answers.
OPENAI_LLM_API_KEY_1=
OPENAI_LLM_API_KEY_2=
OPENAI_LLM_MODEL=gpt-4o-mini
LLM_MAX_CONCURRENCY_PER_PROVIDER=1
LLM_PROVIDER_COOLDOWN_MS=45000

# Optional LLM fallbacks after both OpenAI LLM keys.
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
GOOGLE_API_KEY=
GOOGLE_MODEL=gemini-3.8-flash
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct:free
OPENROUTER_BACKUP_API_KEY=
OPENROUTER_BACKUP_MODEL=google/gemma-2-9b-it:free
OPENCODE_ZEN_API_KEY=
OPENCODE_ZEN_BASE_URL=https://opencode.ai/zen/v1
OPENCODE_ZEN_MODEL=deepseek-v4-flash-free

# STT routing: Groq first -> one isolated OpenAI Whisper-1 key -> Deepgram.
STT_PROVIDER=auto
GROQ_STT_API_KEY=
GROQ_STT_MODEL=whisper-large-v3-turbo
OPENAI_STT_API_KEY=
OPENAI_STT_MODEL=whisper-1
OPENAI_STT_MAX_CONCURRENCY_PER_KEY=1
OPENAI_STT_COOLDOWN_MS=60000
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3

NODE_ENV=production
