# Add secret values only in Railway Variables. Never commit real keys.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_WEBAPP_URL=

# LLM routing order: Groq -> Google -> OpenRouter -> backup -> OpenCode Zen
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
GOOGLE_API_KEY=
GOOGLE_MODEL=gemini-3.8-flash
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct:free
OPENROUTER_BACKUP_API_KEY=
OPENROUTER_BACKUP_MODEL=google/gemma-2-9b-it:free
OPENCODE_ZEN_API_KEY=
OPENCODE_ZEN_BASE_URL=https://opencode.ai/zen/v1
OPENCODE_ZEN_MODEL=deepseek-v4-flash-free

# Voice transcription: Deepgram first when selected, Groq fallback
STT_PROVIDER=deepgram
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3
GROQ_STT_MODEL=whisper-large-v3-turbo

NODE_ENV=production
