PORT=8787
FRONTEND_ORIGIN=http://localhost:5173

# Never commit real keys. Copy this file to .env locally or set these in your hosting provider secrets.
LLM_PROVIDER=auto
LLM_PRIMARY_PROVIDER=groq

# Text LLM providers
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
OPENROUTER_API_KEY=
OPENROUTER_BACKUP_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct:free
OPENROUTER_BACKUP_MODEL=google/gemma-2-9b-it:free
OPENCODE_ZEN_API_KEY=
OPENCODE_ZEN_BASE_URL=
OPENCODE_ZEN_MODEL=
GOOGLE_API_KEY=
GOOGLE_MODEL=gemini-1.5-flash

# Speech-to-text providers
STT_PROVIDER=deepgram
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3
GROQ_STT_MODEL=whisper-large-v3-turbo

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBAPP_URL=http://localhost:5173

DATABASE_PATH=./data/talqyla.json
