{
  "name": "talqyla",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Talqyla Telegram debate trainer",
  "packageManager": "pnpm@9.12.0",
  "engines": { "node": ">=20.0.0" },
  "scripts": {
    "build": "tsc -p backend/tsconfig.json",
    "start": "node backend/dist/polling.js",
    "test": "node tests.js",
    "lint": "pnpm -r run lint",
    "typecheck": "tsc -p backend/tsconfig.json --noEmit",
    "db:generate": "pnpm --filter @talqyla/db prisma:generate",
    "db:deploy": "pnpm --filter @talqyla/db prisma:deploy",
    "db:seed": "pnpm --filter @talqyla/db seed",
    "smoke": "node scripts/smoke.mjs"
  },
  "devDependencies": {
    "@types/node": "^20.16.0",
    "prettier": "^3.3.3",
    "typescript": "^5.6.0"
  }
}
