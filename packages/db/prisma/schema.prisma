// Talqyla — Prisma schema.
//
// Product model (v2, after the debater survey):
//   A SESSION is one speech, not a chat round. The student prepares from a
//   CaseCard, speaks once, optionally takes a single point of information,
//   and receives a judged ballot with exactly one drill.
//
// Conventions:
//   - ids are cuid(); timestamps are UTC; camelCase -> snake_case via @map.
//   - Refresh tokens use the rotating family pattern.
//   - EVERY paid AI call writes a UsageEvent row. That table, not the round,
//     is the source of truth for the daily spend guard.

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
  output        = "../node_modules/@talqyla/prisma-client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────── ENUMS ───────────────────────────────

enum UserRole {
  USER
  ADMIN
}

enum ExperienceLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

// Scored rubric. The first five are live; the last three are retired but
// kept so historical rounds keep rendering (Postgres enums cannot drop
// values while rows reference them).
enum SkillKey {
  STRUCTURE
  CASE_ANALYSIS
  REFUTATION
  SPEED
  ARGUMENTATION
  CONTENT
  LOGIC
  DELIVERY
}

enum TopicCategory {
  SCHOOL
  SOCIETY
  TECHNOLOGY
  ETHICS
  ENVIRONMENT
  SPORTS
  CULTURE
}

enum TopicDifficulty {
  EASY
  MEDIUM
  HARD
}

enum Stance {
  PRO
  CON
}

// Three entry points, one engine.
//   SPEECH — 8–12 min: case card, one speech, ballot, drill.
//   BLITZ  — 60–90 s: one prompt, one short answer, instant micro-verdict.
//   CASE   — 3–5 min: case card study only, no speech, no judge.
enum RoundMode {
  SPEECH
  BLITZ
  CASE
}

enum RoundStatus {
  SETUP
  ARGUMENT_BUILT
  IN_PROGRESS
  AWAITING_JUDGE
  JUDGING
  COMPLETED
  ABORTED
}

enum TurnRole {
  STUDENT
  OPPONENT
}

enum TurnKind {
  OPENING
  REBUTTAL
  QUESTION
  RESPONSE
  CLOSING
  POI
}

enum SttProvider {
  STUB
  GROQ
  OPENAI
}

enum TtsProvider {
  STUB
  OPENAI
  ELEVENLABS
}

// Every paid call is one of these.
enum UsageKind {
  LLM_DEBATER
  LLM_JUDGE
  LLM_SUMMARIZER
  LLM_CASE
  STT
  TTS
}

// ─────────────────────────────── MODELS ───────────────────────────────

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         UserRole @default(USER)
  refreshJti           String?   @map("refresh_jti")
  lastLoginAt          DateTime? @map("last_login_at")
  passwordResetToken   String?   @map("password_reset_token")
  passwordResetExpires DateTime? @map("password_reset_expires")

  // Users are minors: consent is captured at registration and versioned.
  parentEmail            String?   @map("parent_email")
  parentalConsentAt      DateTime? @map("parental_consent_at")
  parentalConsentVersion String?   @map("parental_consent_version")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  studentProfile StudentProfile?
  rounds         DebateRound[]
  refreshTokens  RefreshToken[]
  onboarding     OnboardingQuiz?
  usageEvents    UsageEvent[]

  @@map("users")
}

model StudentProfile {
  id              String           @id @default(cuid())
  userId          String           @unique @map("user_id")
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  grade           Int
  experienceLevel ExperienceLevel  @default(BEGINNER) @map("experience_level")
  focusSkill      SkillKey?        @map("focus_skill")
  goal            String?
  roundsPlayed    Int              @default(0) @map("rounds_played")
  // Weekly league standing is computed from IMPROVEMENT on the focus skill,
  // not from an absolute score: a beginner must be able to win a week.
  ratingPoints    Int              @default(0) @map("rating_points")
  streakDays      Int              @default(0) @map("streak_days")
  lastSessionAt   DateTime?        @map("last_session_at")
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")

  @@index([ratingPoints])
  @@map("student_profiles")
}

model Topic {
  id          String         @id @default(cuid())
  slug        String         @unique
  title       String
  description String
  category    TopicCategory
  difficulty  TopicDifficulty @default(EASY)
  proHint     String?        @map("pro_hint")
  conHint     String?        @map("con_hint")
  createdAt   DateTime       @default(now()) @map("created_at")

  rounds   DebateRound[]
  caseCard CaseCard?

  @@map("topics")
}

// Preparation material. 50% of surveyed debaters named "not enough material
// to prepare" as a top-2 blocker, and the product had none at all.
//
// Generated ONCE per topic by an LLM, reviewed by a human, then served from
// the DB forever. This is why case cards cost effectively nothing per user.
model CaseCard {
  id           String   @id @default(cuid())
  topicId      String   @unique @map("topic_id")
  topic        Topic    @relation(fields: [topicId], references: [id], onDelete: Cascade)
  // string[] — who is affected and how.
  stakeholders Json
  // string[] — the 2–3 clashes this motion actually turns on.
  clashes      Json
  // string[] — typical lines for each side, as raw material, not a script.
  proArguments Json     @map("pro_arguments")
  conArguments Json     @map("con_arguments")
  // string[] — common traps and weak moves on this motion.
  traps        Json
  // Set once a coach has signed off. Unreviewed cards render with a warning.
  reviewedAt   DateTime? @map("reviewed_at")
  reviewedBy   String?   @map("reviewed_by")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  @@map("case_cards")
}

model DebateRound {
  id            String      @id @default(cuid())
  userId        String      @map("user_id")
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  topicId       String      @map("topic_id")
  topic         Topic       @relation(fields: [topicId], references: [id])
  mode          RoundMode   @default(SPEECH)
  stance        Stance
  status        RoundStatus @default(SETUP)
  // Speaker role being trained: PM, LO, DPM, DLO, MG, MO, GW, OW.
  speakerRole   String?     @map("speaker_role")
  argument      Json?
  transcript    Json        @default("[]") @map("transcript")
  exchangesDone Int         @default(0) @map("exchanges_done")
  // Wall-clock length of the recorded speech. Feeds the SPEED score and the
  // "did you use your time" note in the ballot.
  speechSeconds Int?        @map("speech_seconds")
  // Denormalised for the round list. usage_events remains authoritative.
  costEstimateUsd Decimal?  @db.Decimal(8, 4) @map("cost_estimate_usd")
  focusSkill    SkillKey?   @map("focus_skill")
  purgedAt      DateTime?   @map("purged_at")
  startedAt     DateTime    @default(now()) @map("started_at")
  completedAt   DateTime?   @map("completed_at")
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")

  turns       DebateTurn[]
  skillScores SkillScore[]
  feedback    RoundFeedback?
  usageEvents UsageEvent[]

  @@index([userId, status])
  @@index([userId, completedAt])
  @@index([userId, createdAt])
  @@index([userId, mode, createdAt])
  @@index([createdAt])
  @@map("debate_rounds")
}

model DebateTurn {
  id           String    @id @default(cuid())
  roundId      String    @map("round_id")
  round        DebateRound @relation(fields: [roundId], references: [id], onDelete: Cascade)
  idx          Int
  role         TurnRole
  kind         TurnKind
  contentText  String    @map("content_text")
  question     String?
  audioUrl     String?   @map("audio_url")
  citationRefs Json?     @default("[]") @map("citation_refs")
  tokensIn     Int       @default(0) @map("tokens_in")
  tokensOut    Int       @default(0) @map("tokens_out")
  costUsd      Decimal   @default(0) @db.Decimal(8, 6) @map("cost_usd")
  sttProvider  SttProvider? @map("stt_provider")
  ttsProvider  TtsProvider? @map("tts_provider")
  purgedAt     DateTime? @map("purged_at")
  createdAt    DateTime  @default(now()) @map("created_at")

  @@unique([roundId, idx])
  @@index([roundId, idx])
  @@index([createdAt])
  @@map("debate_turns")
}

model SkillScore {
  id        String   @id @default(cuid())
  roundId   String   @map("round_id")
  round     DebateRound @relation(fields: [roundId], references: [id], onDelete: Cascade)
  skill     SkillKey
  score     Int
  comment   String?
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([roundId, skill])
  @@index([skill])
  @@map("skill_scores")
}

model RoundFeedback {
  id           String   @id @default(cuid())
  roundId      String   @unique @map("round_id")
  round        DebateRound @relation(fields: [roundId], references: [id], onDelete: Cascade)
  totalScore   Int // 0–50
  strengths    Json
  weaknesses   Json
  advice       Json
  summaryText  String  @map("summary_text")
  // The one thing to do next. The survey's loudest complaint was feedback
  // that arrives "sometimes" and leads nowhere, so a ballot without a drill
  // is considered incomplete.
  drillSkill   SkillKey? @map("drill_skill")
  drillPrompt  String?   @map("drill_prompt")
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@map("round_feedback")
}

// Every paid AI call. Written before the budget is re-read, so the daily cap
// sees STT and TTS too. Previously both bypassed every spend control.
model UsageEvent {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  roundId   String?  @map("round_id")
  round     DebateRound? @relation(fields: [roundId], references: [id], onDelete: SetNull)
  kind      UsageKind
  provider  String
  model     String
  tokensIn  Int      @default(0) @map("tokens_in")
  tokensOut Int      @default(0) @map("tokens_out")
  /// Tokens for LLM, seconds for STT, characters for TTS.
  units     Int      @default(0)
  costUsd   Decimal  @default(0) @db.Decimal(10, 6) @map("cost_usd")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId, createdAt])
  @@index([kind, createdAt])
  @@index([roundId])
  @@map("usage_events")
}

model OnboardingQuiz {
  id             String           @id @default(cuid())
  userId         String           @unique @map("user_id")
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  grade          Int
  priorExperience String          @map("prior_experience")
  goal           String
  logicAnswer    String           @map("logic_answer")
  derivedLevel   ExperienceLevel  @map("derived_level")
  createdAt      DateTime         @default(now()) @map("created_at")

  @@map("onboarding_quizzes")
}

model RefreshToken {
  id         String   @id @default(cuid())
  userId     String   @map("user_id")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  jti        String   @unique
  family     String
  hashed     String
  expiresAt  DateTime @map("expires_at")
  revokedAt  DateTime? @map("revoked_at")
  replacedBy String?  @map("replaced_by")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([family])
  @@index([expiresAt])
  @@map("refresh_tokens")
}
