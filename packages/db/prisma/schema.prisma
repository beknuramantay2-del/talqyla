// Talqyla — Prisma schema.
//
// v2 (2026-08): продукт переехал с «раунд из трёх обменов против AI-оппонента»
// на «одна речь + разбор + дрилл». Опрос дебатёров показал, что нехватка
// оппонентов волнует 6% респондентов, а нехватка практики, материала и
// регулярного фидбека — 81%, 50% и 56%. Модель данных следует за этим.
//
// Старые DebateRound/DebateTurn НЕ удалены: на них есть история и миграции.
// Новый цикл живёт в PracticeSession. Удалять раунды можно только после
// переноса истории.

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
  output        = "../node_modules/@talqyla/prisma-client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────── ENUMS ───────────────────────────────

enum UserRole {
  USER
  ADMIN
}

enum ExperienceLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

// Рубрика v2. STRUCTURE / CASE_ANALYSIS / QUICK_THINKING — топ-3 запроса из
// опроса. CONTENT = аргументация. DELIVERY больше не оценивается судьёй
// (её не назвал ни один респондент), но значение остаётся в enum ради истории.
enum SkillKey {
  STRUCTURE
  CONTENT
  REFUTATION
  LOGIC
  DELIVERY
  CASE_ANALYSIS
  QUICK_THINKING
}

enum TopicCategory {
  SCHOOL
  SOCIETY
  TECHNOLOGY
  ETHICS
  ENVIRONMENT
  SPORTS
  CULTURE
}

enum TopicDifficulty {
  EASY
  MEDIUM
  HARD
}

enum Stance {
  PRO
  CON
}

// Три режима одного движка.
//   SPEECH — 8–12 мин: роль, кейс-карта, речь, ballot, дрилл.
//   BLITZ  — 60–90 сек: один короткий вызов, тренирует скорость мышления.
//   CASE   — 3–5 мин: только разбор темы, без речи.
enum SessionMode {
  SPEECH
  BLITZ
  CASE
}

enum SessionStatus {
  PREP
  SPEAKING
  SCORING
  COMPLETED
  ABORTED
}

// Роль спикера. Определяет, что судья считает выполнением роли.
enum SpeakerRole {
  PM
  LO
  DPM
  DLO
  MG
  MO
  GW
  OW
}

enum RoundStatus {
  SETUP
  ARGUMENT_BUILT
  IN_PROGRESS
  AWAITING_JUDGE
  JUDGING
  COMPLETED
  ABORTED
}

enum TurnRole {
  STUDENT
  OPPONENT
}

enum TurnKind {
  OPENING
  REBUTTAL
  QUESTION
  RESPONSE
  CLOSING
}

enum SttProvider {
  STUB
  GROQ
  OPENAI
}

enum TtsProvider {
  STUB
  OPENAI
  ELEVENLABS
}

// Вид платного вызова. Нужен, чтобы понимать, куда реально уходят деньги.
enum UsageKind {
  LLM_DEBATER
  LLM_JUDGE
  LLM_SUMMARIZER
  LLM_CASE
  STT
  TTS
}

// ─────────────────────────────── MODELS ───────────────────────────────

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         UserRole @default(USER)
  refreshJti           String?   @map("refresh_jti")
  lastLoginAt          DateTime? @map("last_login_at")
  passwordResetToken   String?   @map("password_reset_token")
  passwordResetExpires DateTime? @map("password_reset_expires")

  parentEmail            String?   @map("parent_email")
  parentalConsentAt      DateTime? @map("parental_consent_at")
  parentalConsentVersion String?   @map("parental_consent_version")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  studentProfile StudentProfile?
  rounds         DebateRound[]
  sessions       PracticeSession[]
  usageEvents    UsageEvent[]
  refreshTokens  RefreshToken[]
  onboarding     OnboardingQuiz?

  @@map("users")
}

model StudentProfile {
  id              String           @id @default(cuid())
  userId          String           @unique @map("user_id")
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  grade           Int
  experienceLevel ExperienceLevel  @default(BEGINNER) @map("experience_level")
  focusSkill      SkillKey?        @map("focus_skill")
  goal            String?
  roundsPlayed    Int              @default(0) @map("rounds_played")
  // v2: сессий больше, чем раундов, и рейтинг считается по ним.
  sessionsPlayed  Int              @default(0) @map("sessions_played")
  // Очки недельной лиги. Растут за прирост слабого навыка, а не за объём.
  ratingPoints    Int              @default(0) @map("rating_points")
  streakDays      Int              @default(0) @map("streak_days")
  lastSessionAt   DateTime?        @map("last_session_at")
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")

  @@index([ratingPoints])
  @@map("student_profiles")
}

model Topic {
  id          String         @id @default(cuid())
  slug        String         @unique
  title       String
  description String
  category    TopicCategory
  difficulty  TopicDifficulty @default(EASY)
  proHint     String?        @map("pro_hint")
  conHint     String?        @map("con_hint")
  createdAt   DateTime       @default(now()) @map("created_at")

  rounds   DebateRound[]
  sessions PracticeSession[]
  caseCard CaseCard?

  @@map("topics")
}

// Кейс-карта: материал для подготовки. 50% респондентов назвали его нехватку
// вторым ограничителем роста. Генерируется один раз на тему и кешируется —
// это самый дешёвый способ отдать ценность без вызова модели на каждого ученика.
model CaseCard {
  id           String   @id @default(cuid())
  topicId      String   @unique @map("topic_id")
  topic        Topic    @relation(fields: [topicId], references: [id], onDelete: Cascade)
  // string[] — кого затрагивает резолюция.
  stakeholders Json
  // { title, gov, opp }[] — вероятные точки столкновения.
  clashes      Json
  // string[] — типовые аргументы стороны.
  govLines     Json     @map("gov_lines")
  oppLines     Json     @map("opp_lines")
  // string[] — ловушки, на которых обычно сыпятся.
  traps        Json
  // Версия промпта: если поменяли генератор, старые карты видно.
  promptVersion String  @default("2026-08") @map("prompt_version")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("case_cards")
}

// Ядро v2: одна тренировочная сессия.
model PracticeSession {
  id          String        @id @default(cuid())
  userId      String        @map("user_id")
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  topicId     String        @map("topic_id")
  topic       Topic         @relation(fields: [topicId], references: [id])
  mode        SessionMode   @default(SPEECH)
  status      SessionStatus @default(PREP)
  role        SpeakerRole   @default(PM)
  stance      Stance
  // Навык, под который заточена сессия. Приходит из profile.focusSkill.
  focusSkill  SkillKey?     @map("focus_skill")

  // Речь ученика (STT или текстовый fallback).
  speechText  String?       @map("speech_text")
  speechSec   Int?          @map("speech_sec")
  // POI, прилетевший в середине речи. Единственное, что осталось от оппонента.
  poiText     String?       @map("poi_text")
  poiAnswer   String?       @map("poi_answer")

  // Ballot.
  totalScore  Int?          @map("total_score")
  summaryText String?       @map("summary_text")
  strengths   Json          @default("[]")
  weaknesses  Json          @default("[]")
  // Ровно один следующий дрилл. Не список советов.
  drillText   String?       @map("drill_text")
  drillSkill  SkillKey?     @map("drill_skill")
  ratingDelta Int           @default(0) @map("rating_delta")

  costUsd     Decimal       @default(0) @db.Decimal(10, 6) @map("cost_usd")
  purgedAt    DateTime?     @map("purged_at")
  completedAt DateTime?     @map("completed_at")
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  scores SessionScore[]

  @@index([userId, status])
  @@index([userId, createdAt])
  @@index([createdAt])
  @@map("practice_sessions")
}

model SessionScore {
  id        String          @id @default(cuid())
  sessionId String          @map("session_id")
  session   PracticeSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  skill     SkillKey
  score     Int
  comment   String?
  createdAt DateTime        @default(now()) @map("created_at")

  @@unique([sessionId, skill])
  @@index([skill])
  @@map("session_scores")
}

// Учёт КАЖДОГО платного вызова. Миграция появилась раньше модели, из-за чего
// prisma.usageEvent не существовал и весь spend-контроль был мёртвым кодом.
model UsageEvent {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Может ссылаться и на сессию, и на раунд — поэтому без внешнего ключа.
  roundId   String?   @map("round_id")
  kind      UsageKind
  provider  String
  model     String
  tokensIn  Int       @default(0) @map("tokens_in")
  tokensOut Int       @default(0) @map("tokens_out")
  // Токены для LLM, секунды для STT, символы для TTS.
  units     Int       @default(0)
  costUsd   Decimal   @default(0) @db.Decimal(10, 6) @map("cost_usd")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([userId, createdAt])
  @@index([kind, createdAt])
  @@map("usage_events")
}

// ── Legacy v1: раунды с тремя обменами. Только чтение истории. ──────────

model DebateRound {
  id            String      @id @default(cuid())
  userId        String      @map("user_id")
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  topicId       String      @map("topic_id")
  topic         Topic       @relation(fields: [topicId], references: [id])
  stance        Stance
  status        RoundStatus @default(SETUP)
  argument      Json?
  transcript    Json        @default("[]") @map("transcript")
  exchangesDone Int         @default(0) @map("exchanges_done")
  costEstimateUsd Decimal?  @db.Decimal(8, 4) @map("cost_estimate_usd")
  focusSkill    SkillKey?   @map("focus_skill")
  purgedAt      DateTime?   @map("purged_at")
  startedAt     DateTime    @default(now()) @map("started_at")
  completedAt   DateTime?   @map("completed_at")
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")

  turns       DebateTurn[]
  skillScores SkillScore[]
  feedback    RoundFeedback?

  @@index([userId, status])
  @@index([userId, completedAt])
  @@index([userId, createdAt])
  @@index([createdAt])
  @@map("debate_rounds")
}

model DebateTurn {
  id           String    @id @default(cuid())
  roundId      String    @map("round_id")
  round        DebateRound @relation(fields: [roundId], references: [id], onDelete: Cascade)
  idx          Int
  role         TurnRole
  kind         TurnKind
  contentText  String    @map("content_text")
  question     String?
  audioUrl     String?   @map("audio_url")
  citationRefs Json?     @default("[]") @map("citation_refs")
  tokensIn     Int       @default(0) @map("tokens_in")
  tokensOut    Int       @default(0) @map("tokens_out")
  costUsd      Decimal   @default(0) @db.Decimal(8, 6) @map("cost_usd")
  sttProvider  SttProvider? @map("stt_provider")
  ttsProvider  TtsProvider? @map("tts_provider")
  purgedAt     DateTime? @map("purged_at")
  createdAt    DateTime  @default(now()) @map("created_at")

  @@index([roundId, idx])
  @@index([createdAt])
  @@map("debate_turns")
}

model SkillScore {
  id        String   @id @default(cuid())
  roundId   String   @map("round_id")
  round     DebateRound @relation(fields: [roundId], references: [id], onDelete: Cascade)
  skill     SkillKey
  score     Int
  comment   String?
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([roundId, skill])
  @@index([skill])
  @@map("skill_scores")
}

model RoundFeedback {
  id           String   @id @default(cuid())
  roundId      String   @unique @map("round_id")
  round        DebateRound @relation(fields: [roundId], references: [id], onDelete: Cascade)
  totalScore   Int
  strengths    Json
  weaknesses   Json
  advice       Json
  summaryText  String  @map("summary_text")
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@map("round_feedback")
}

model OnboardingQuiz {
  id             String           @id @default(cuid())
  userId         String           @unique @map("user_id")
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  grade          Int
  priorExperience String          @map("prior_experience")
  goal           String
  logicAnswer    String           @map("logic_answer")
  derivedLevel   ExperienceLevel  @map("derived_level")
  createdAt      DateTime         @default(now()) @map("created_at")

  @@map("onboarding_quizzes")
}

model RefreshToken {
  id         String   @id @default(cuid())
  userId     String   @map("user_id")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  jti        String   @unique
  family     String
  hashed     String
  expiresAt  DateTime @map("expires_at")
  revokedAt  DateTime? @map("revoked_at")
  replacedBy String?  @map("replaced_by")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([family])
  @@index([expiresAt])
  @@map("refresh_tokens")
}
